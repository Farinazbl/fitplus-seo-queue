# نمونه: هر توکن حداقل ۱۶ نویسه تصادفی باشد (مثلاً خروجی: openssl rand -hex 16)
APP_TOKENS=sara=CHANGE-ME-admin-token-123:admin
APP_DB=/data/agents.db
APP_TZ=Asia/Tehran

# مدل زبانی: یکی از دو کلید کافی است (OpenAI سازگار؛ برای سرویس‌های سازگار OPENAI_BASE_URL را هم بگذارید)
# OPENAI_API_KEY=
# APP_LLM_MODEL=gpt-4o-mini

# تصویر پست‌ها: مسیر فایل فونت یکان‌بخ (.ttf) و مدل تصویر OpenAI
# APP_FONT=C:\path\to\BakhYekan.ttf
# APP_IMAGE_MODEL=gpt-image-1
